# Opcional. O JSON persistente padrão fica em %LOCALAPPDATA%\LMF-Control\data\lmf_control.json.
LMF_DATA_DIR=./data
# LMF_JSON_DB_PATH=./data/lmf_control.json


# Ponte opcional para sincronização manual de um snapshot JSON no Supabase.
# Mantida desativada. Não coloque credenciais reais neste arquivo.
LMF_SUPABASE_SYNC_ENABLED=false
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use uma secret key sb_secret_* (preferível) ou a chave legada service_role.
# SUPABASE_SECRET_KEY=
