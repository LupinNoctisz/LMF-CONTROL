# Opcional. O JSON persistente padrão fica em %LOCALAPPDATA%\LMF-Control\data\lmf_control.json.
LMF_DATA_DIR=./data
# LMF_JSON_DB_PATH=./data/lmf_control.json


# Ponte opcional para sincronização manual de um snapshot JSON no Supabase.
# Mantida desativada. Não coloque credenciais reais neste arquivo.
LMF_SUPABASE_SYNC_ENABLED=false
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use uma secret key sb_secret_* (preferível) ou a chave legada service_role.
# SUPABASE_SECRET_KEY=

# Destino da migração JSON -> PostgreSQL (scripts/migrate_json_to_postgres.py). O app ainda NÃO usa esta URL.
# Use a senha do banco apenas no seu ambiente local; nunca commite credenciais reais.
# LMF_DATABASE_URL=postgresql+psycopg://usuario:SENHA@host:5432/banco
# Somente para testes automatizados: banco PostgreSQL DESCARTÁVEL (o schema public é apagado).
# LMF_TEST_DATABASE_URL=postgresql+psycopg://usuario@127.0.0.1:5432/lmf_test
